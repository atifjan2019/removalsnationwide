# Copy to .env.local for development. Production values live in the Vercel project.

# Cloudflare account that holds the D1 database and the R2 buckets.
CLOUDFLARE_ACCOUNT_ID=3c76920fa5848e9b288777b0edae64fa
# API token with "D1: Edit" and "Workers R2 Storage: Edit" on that account.
# R2 S3 credentials are derived from it unless R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are set.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=3b69f53f-2e42-417f-a3fa-03d9d9ddab13
R2_MEDIA_BUCKET=removals-nationwide-media
R2_UPLOADS_BUCKET=removals-nationwide-uploads
R2_UPLOADS_JURISDICTION=eu

# Admin sign-in and the key that protects the stored SMTP password.
# ADMIN_SESSION_SECRET must match the previous deployment, or the SMTP password
# saved in the admin settings cannot be decrypted and has to be re-entered.
ADMIN_PIN=
MASTER_ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Fallback SMTP values, used only when the admin settings hold none.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Browser-visible Google Maps JavaScript API key (restricted by referrer).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=https://removalsnationwide.uk
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.removalsnationwide.uk
